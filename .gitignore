__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
build/
dist/

# data is never committed
data/
*.hea
*.dat
*.npy
*.npz

# large artefacts
checkpoints/
*.ckpt
*.pt
*.pth
wandb/

# results: keep the tables, not the raw dumps
results/**/raw/

data/
*.zip
.venv/
# The per-record predictions are the input to scripts/analyse.py, so they are
# tracked despite the blanket *.npz rule above: about 600 KB per run and some
# 60 MB for all 48. Without them results/ cannot be re-analysed off the pod,
# which is the one thing step 8 of the runbook exists to guarantee.
!results/**/*.npz
!results/*.npz

# application material - must never reach a public repo
altro materiale application/
